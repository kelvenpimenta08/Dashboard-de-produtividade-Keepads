{
  "version": 2,
  "functions": {
    "api/refresh.js": {
      "maxDuration": 60
    },
    "api/note.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/refresh", "dest": "/api/refresh.js" },
    { "src": "/api/note", "dest": "/api/note.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
